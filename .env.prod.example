# Production docker-compose overrides
# Copy to .env alongside docker-compose.prod.yml and customise the domains.

# Primary hostname served by Caddy and Django.
FRONTEND_DOMAIN=example.com

# Optional www hostname. Leave blank to disable the secondary host.
FRONTEND_WWW_DOMAIN=www.example.com

# Public URL for the backend API. Used by the frontend build and runtime CORS checks.
API_BASE_URL=https://example.com/api
