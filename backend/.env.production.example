# Backend production environment configuration
# Copy this file to backend/.env.production and update the values for your deployment.

# === Required secrets ===
# 32-byte urlsafe base64-encoded key shared by all backend services. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=8wfsecdopt6Fz6ZRlo6RLWF2zOWITlzv9uVSXnscJFA=

# OpenAI API key used for all chat completions.
OPENAI_API_KEY=sk-live-change-me

# Optional: override the OpenAI chat completion model (defaults to gpt-4o-mini).
# OPENAI_COMPLETION_MODEL=gpt-4o

# Django secret key. Required whenever ENV=production or DEBUG=False.
DJANGO_SECRET_KEY=django-insecure-change-me

# Set to "production" when running the production stack.
ENV=production

# Never run production with DEBUG enabled.
DEBUG=False

# === Host, CSRF, and CORS configuration ===
# Comma-separated list of hostnames served by Django.
ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated list of HTTPS origins permitted for CSRF-protected POSTs.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Comma-separated list of HTTPS origins allowed for cross-origin requests.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional: allow regex-based origins (comma-separated). Leave blank to disable.
CORS_ALLOWED_ORIGIN_REGEXES=

# Optional: permit all origins. Leave "False" unless you fully understand the security trade-offs.
CORS_ALLOW_ALL_ORIGINS=False

# === Database configuration ===
# PostgreSQL connection settings shared by the web, worker, and migration jobs.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me
# Hostname of the PostgreSQL service inside docker-compose.
POSTGRES_HOST=db
# Port exposed by PostgreSQL.
POSTGRES_PORT=5432

# === Cookie security ===
# Ensure cookies remain secure when proxied through HTTPS.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# === Logging ===
# Application log level (e.g. DEBUG, INFO, WARNING).
LOG_LEVEL=INFO
