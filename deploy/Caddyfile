{$FRONTEND_DOMAIN} {$FRONTEND_WWW_DOMAIN} {
  encode zstd gzip

  # Optional: provide an email for ACME/Let's Encrypt notices
  # acme_ca https://acme-v02.api.letsencrypt.org/directory
  # email you@example.com

  # Serve collected static files directly from the shared volume
  handle_path /static/* {
    root * /srv/staticfiles
    file_server
  }

  # --- Proxy all backend (Django) routes ---
  # Match both the exact /admin and everything under it,
  # same for /api and /media paths.
  @backend path /api /api/* /admin /admin/* /media /media/*
  reverse_proxy @backend backend:8000

  # Everything else goes to the frontend (React)
  reverse_proxy frontend:80

  # Basic security headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "no-referrer-when-downgrade"
  }
}